# Web (Emscripten) build: all game overlays are statically linked into one
# module. The canonical source lists come from mk/version/us.mk; web
# redefines unit/overlay so the lists produce wasm objects only - no asm,
# no generated objects, and no PSX startup file.

# Point ASM_DIR at a nonexistent directory in case anything expands it.
ASM_DIR := $(BUILD_DIR)/no_such_asm_dir

# src/main/_psstart.c is psx startup asm (raw MIPS __asm__ on non-MWERKS)
# and has no place on web; the host main() in src/web/host/main.c calls
# the game's dw_main() directly.
define unit
$(1)_C_SRC := $$(filter-out src/main/_psstart.c,$$($(1)_C_SRC))
$(1)_OBJ := $$($(1)_C_SRC:%=$$(BUILD_DIR)/%.o)
$(1)_DEP := $$($(1)_OBJ:%.o=%.d)
OBJ += $$($(1)_OBJ)
DEP += $$($(1)_DEP)
endef

define overlay
$(call unit,$(1),$(2))
endef

OBJ :=
DEP :=

include mk/version/us.mk

# Web host layer + PsyQ stub surface.
WEB_C_SRC := \
	$(wildcard src/web/host/*.c) \
	$(wildcard src/web/psx/*.c)

$(eval $(call unit,WEB,web))

# Authentic libgte lookup tables (rsin_tbl, SQRT, ratan_tbl, rcossin_tbl)
# extracted from the splat data dump by tools/gen_web_data.py.
$(GEN_DIR)/libgte_tables.c: tools/gen_web_data.py \
		asm/us/main/data/psyq/libgte.data.s
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_web_data.py $@

OBJ += $(BUILD_DIR)/$(GEN_DIR)/libgte_tables.c.o

# Overlay .data reset tables (src/web/host/overlay.c): enumerate the
# writable globals of each overlay object so their initial bytes can be
# snapshotted at startup and restored on each loadDynamicLibrary() call.
# Regenerated after the overlay objects are compiled.
comma := ,
empty :=
space := $(empty) $(empty)
LLVM_NM ?= /emsdk/upstream/bin/llvm-nm

$(GEN_DIR)/overlay_syms.c: tools/gen_overlay_syms.py \
	$(BTL_OBJ) $(DGET_OBJ) $(DOO2_OBJ) $(DOOA_OBJ) $(EAB_OBJ) \
	$(ENDI_OBJ) $(EVL_OBJ) $(FISH_OBJ) $(KAR_OBJ) $(MOV_OBJ) \
	$(MURD_OBJ) $(SHOP_OBJ) $(STD_OBJ) $(TRN_OBJ) $(TRN2_OBJ) $(VS_OBJ)
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_overlay_syms.py $@ nm=$(LLVM_NM) \
		btl=$(subst $(space),$(comma),$(BTL_OBJ)) \
		dget=$(subst $(space),$(comma),$(DGET_OBJ)) \
		doo2=$(subst $(space),$(comma),$(DOO2_OBJ)) \
		dooa=$(subst $(space),$(comma),$(DOOA_OBJ)) \
		eab=$(subst $(space),$(comma),$(EAB_OBJ)) \
		endi=$(subst $(space),$(comma),$(ENDI_OBJ)) \
		evl=$(subst $(space),$(comma),$(EVL_OBJ)) \
		fish=$(subst $(space),$(comma),$(FISH_OBJ)) \
		kar=$(subst $(space),$(comma),$(KAR_OBJ)) \
		mov=$(subst $(space),$(comma),$(MOV_OBJ)) \
		murd=$(subst $(space),$(comma),$(MURD_OBJ)) \
		shop=$(subst $(space),$(comma),$(SHOP_OBJ)) \
		std=$(subst $(space),$(comma),$(STD_OBJ)) \
		trn=$(subst $(space),$(comma),$(TRN_OBJ)) \
		trn2=$(subst $(space),$(comma),$(TRN2_OBJ)) \
		vs=$(subst $(space),$(comma),$(VS_OBJ))

# Generated table: compile without the PsyQ include path (same as the
# web host layer - system headers only).
$(BUILD_DIR)/$(GEN_DIR)/overlay_syms.c.o: CPPFLAGS = \
	-DLANGUAGE_C -D$(VERSION_MACRO) -DPLATFORM_WEB \
	-Iinclude -Isrc -I$(GEN_DIR)

OBJ += $(BUILD_DIR)/$(GEN_DIR)/overlay_syms.c.o

# These TUs embed Shift-JIS text literals. The gcc build relies on
# -finput-charset=UTF-8 -fexec-charset=CP932 to transcode them; clang has no
# CP932 exec charset, so the web build compiles octal-escaped copies
# generated by tools/escape_literals.py instead. Object paths (and the
# per-TU -D overrides in emcc.mk) are unchanged.
SJIS_TUS := \
	src/main/battle_ui.c \
	src/main/main_menu.c \
	src/shop/script_menu.c \
	src/std/std_main.c \
	src/trn/trn_hud.c \
	src/trn2/trn2_hud.c \
	src/vs/vs_combat.c \
	src/vs/vs_demo.c \
	src/vs/vs_intro.c \
	src/vs/vs_select.c

SJIS_OBJS := $(SJIS_TUS:%=$(BUILD_DIR)/%.o)

$(GEN_DIR)/xform/%.c: %.c tools/escape_literals.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/escape_literals.py $< $@

$(SJIS_OBJS): $(BUILD_DIR)/%.c.o: $(GEN_DIR)/xform/%.c
	@mkdir -p $(dir $@)
	$(CC) -c $(CFLAGS) $(CPPFLAGS) $(DEPFLAGS) -o $@ $<
